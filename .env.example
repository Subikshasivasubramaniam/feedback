# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local MongoDB:      mongodb://127.0.0.1:27017/eventFeedbackDB
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventFeedbackDB
MONGO_URI=mongodb://127.0.0.1:27017/eventFeedbackDB

# Port the Express server will run on
PORT=5000
